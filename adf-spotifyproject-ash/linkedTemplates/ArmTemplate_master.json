{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-spotifyproject-ash"
		},
		"azdatalake_con_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'azdatalake_con'"
		},
		"azsqldb_con_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'azsqldb_con'"
		},
		"azdatalake_con_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://spotifyprojectdatalake.dfs.core.windows.net/"
		},
		"azsqldb_con_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azurespotifyprojserver.database.windows.net"
		},
		"azsqldb_con_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azurespotifyprojectdb"
		},
		"azsqldb_con_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminash"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-spotifyproject-ash_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"azdatalake_con_accountKey": {
						"value": "[parameters('azdatalake_con_accountKey')]"
					},
					"azsqldb_con_password": {
						"value": "[parameters('azsqldb_con_password')]"
					},
					"azdatalake_con_properties_typeProperties_url": {
						"value": "[parameters('azdatalake_con_properties_typeProperties_url')]"
					},
					"azsqldb_con_properties_typeProperties_server": {
						"value": "[parameters('azsqldb_con_properties_typeProperties_server')]"
					},
					"azsqldb_con_properties_typeProperties_database": {
						"value": "[parameters('azsqldb_con_properties_typeProperties_database')]"
					},
					"azsqldb_con_properties_typeProperties_userName": {
						"value": "[parameters('azsqldb_con_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}